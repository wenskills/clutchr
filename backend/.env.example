# Django
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (ignoré si USE_SQLITE=True)
DB_NAME=clutchr
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
USE_SQLITE=True

# CORS / Frontend
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
FRONTEND_URL=http://localhost:4200

# E-mail (dev: les mails s'affichent dans la console du serveur)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@clutchr.app

# Connexion Google (Identity Services) — laisser vide pour désactiver proprement
GOOGLE_CLIENT_ID=

# Recherche d'offres — Adzuna (gratuit, inscription : https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr

LOG_LEVEL=INFO

# Planification automatique (optionnel) :
# python manage.py run_scraping
# À programmer via cron (Linux/Mac) ou Planificateur de tâches (Windows).
# Voir le docstring en haut de jobs/management/commands/run_scraping.py
# pour un exemple de ligne crontab (3x/jour).

# Contenu LinkedIn — Gemini (réutilise la clé déjà utilisée pour ATlaS)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Deuxième source d'offres — France Travail (officiel, OAuth2)
# Inscription gratuite : https://francetravail.io/inscription
# Les noms de ville libres (ex: "Marseille") sont résolus automatiquement
# en code INSEE via geo.api.gouv.fr (gratuit, sans clé).
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=

# Ressources vidéo de la Roadmap — YouTube Data API v3 (gratuite)
# Console Google Cloud : activer "YouTube Data API v3" puis créer une clé
YOUTUBE_API_KEY=
